# Discord
DISCORD_TOKEN=seu_token_do_discord
CLIENT_ID=seu_application_id
GUILD_ID=opcional_id_do_servidor_para_testes_rapidos

# Spotify (opcional, mas recomendado para autocomplete, busca e links do Spotify)
SPOTIFY_CLIENT_ID=seu_client_id_spotify
SPOTIFY_CLIENT_SECRET=seu_client_secret_spotify
SPOTIFY_MARKET=BR

# Gemini (Google AI Studio) — para IA, recomendações, banners e verificação de usuários
GEMINI_API_KEY=sua_chave_do_google_ai_studio
GEMINI_MODEL=gemini-2.5-pro

# yt-dlp
YTDLP_PATH=yt-dlp
# Exemplo com node runtime (necessário para YouTube em 2026):
YTDLP_EXTRA_ARGS=--js-runtimes node --no-warnings
# YTDLP_COOKIES=caminho/para/cookies.txt  # opcional, se o YouTube pedir login

# Fila
DEFAULT_VOLUME=50
MAX_QUEUE=500
SEARCH_RESULTS=10

# Auto-refill da fila (quando chega no final, a IA adiciona mais músicas)
AUTO_REFILL=true
REFILL_THRESHOLD=5    # quantas músicas restam para disparar o refill
REFILL_SIZE=30        # quantas músicas adicionar por refill (máx. 30)

# Salas de voz privadas
ROOMS_CATEGORY_ID=
ROOM_EMPTY_DELETE_SECONDS=30
MAX_ROOMS_PER_USER=1
